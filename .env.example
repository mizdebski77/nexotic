# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit your real keys.

# Resend (transactional email — contact form replies)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Groq (powers the on-site AI chatbot)
# Get a key at https://console.groq.com/keys — free tier is plenty for low traffic.
GROQ_API_KEY=
